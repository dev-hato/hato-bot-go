{
  "extends": ["github>dev-hato/renovate-config"],
  "ignoreDeps": ["node-fetch", "golang", "python"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: (?<currentValue>\\S+)(?:\\s+\\w+_SHA256: (?<currentDigest>[0-9a-f]{64}))?"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
